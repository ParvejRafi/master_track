# Copy to .env for local development. All of these are optional locally —
# without a .env, the app falls back to DEBUG=True + SQLite.

SECRET_KEY=dev-secret-key-change-me
DEBUG=True

# Leave unset locally to use SQLite. Set to a Postgres URL (e.g. from Neon) in production.
# DATABASE_URL=postgresql://user:password@host/dbname

ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated list of origins Django trusts for unsafe (POST) requests,
# e.g. the Django admin login. Needed in production behind HTTPS.
CSRF_TRUSTED_ORIGINS=

# Accounts are created via invite codes issued through Django admin
# (Accounts > Invite codes) — there is no shared registration secret.
